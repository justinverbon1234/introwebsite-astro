---
import { getCollection, render } from "astro:content";

import Layout from "../../layouts/Layout.astro";

import "../../styles/journal/entry.css";
import "../../styles/journal/article.css";
import "../../styles/journal/thought.css";
import "../../styles/journal/project.css";
import "../../styles/journal/school-notes.css";

export async function getStaticPaths() {
    const entries = await getCollection("journal");

    const sortedEntries = entries.sort(
        (a, b) =>
            b.data.date.getTime() -
            a.data.date.getTime()
    );

    return sortedEntries.map((entry, index) => {
        const previousEntry = sortedEntries[index - 1] ?? null;
        const nextEntry = sortedEntries[index + 1] ?? null;

        return {
            params: {
                id: entry.id,
            },

            props: {
                entry,
                previousEntry,
                nextEntry,
            },
        };
    });
}

const {
    entry,
    previousEntry,
    nextEntry,
} = Astro.props;

const { Content } = await render(entry);

const category = entry.data.category;
const categoryClass = category.toLowerCase();

const seriesClass = entry.data.series
    ? `journal-entry--${entry.data.series}`
    : "";

const formattedDate = entry.data.date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
});
---

<Layout
    title={`${entry.data.title} | Justin Verbon`}
    description={entry.data.description}
>
    <main
        class={`journal-entry journal-entry--${categoryClass} ${seriesClass}`}
    >
        <header class="entry-header">
            <div class="entry-header-top">
                <p class="entry-eyebrow">
                    {entry.data.eyebrow}
                </p>

                <p class="entry-category">
                    {category}
                </p>
            </div>

            <div class="entry-heading">
                <h1 class="entry-title">
                    {entry.data.title}
                </h1>

                <p class="entry-description">
                    {entry.data.description}
                </p>
            </div>

            <div class="entry-meta">
                <p>{formattedDate}</p>

                {
                    entry.data.readTime && (
                        <p>{entry.data.readTime}</p>
                    )
                }

                {
                    entry.data.status && (
                        <p>{entry.data.status}</p>
                    )
                }
            </div>
        </header>

        <div class="entry-content">
            <Content />
        </div>

        <nav
            class="entry-navigation"
            aria-label="Journal navigation"
        >
            <div class="entry-navigation-previous">
                {
                    previousEntry && (
                        <a href={`/journal/${previousEntry.id}/`}>
                            <span class="entry-navigation-label">
                                Previous Article
                            </span>

                            <span class="entry-navigation-title">
                                ← {previousEntry.data.title}
                            </span>
                        </a>
                    )
                }
            </div>

            <div class="entry-navigation-index">
                <a href="/journal/">
                    Journal
                </a>
            </div>

            <div class="entry-navigation-next">
                {
                    nextEntry && (
                        <a href={`/journal/${nextEntry.id}/`}>
                            <span class="entry-navigation-label">
                                Next Article
                            </span>

                            <span class="entry-navigation-title">
                                {nextEntry.data.title} →
                            </span>
                        </a>
                    )
                }
            </div>
        </nav>
    </main>
</Layout>