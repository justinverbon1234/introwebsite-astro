---
import Navbar from '../components/Navbar.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Justin Verbon - Designer',
    description = 'Digital Designer exploring art, fashion, and technology.',
} = Astro.props;

import '../styles/base.css';
import '../styles/components.css';
import '../styles/layout.css';
---

<!doctype html>

<html lang="en">

    <head>

        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <meta name="description" content={description} />

        <title>{title}</title>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />

        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />

        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@100;400;500;600&family=The+Nautigal:wght@400;700&display=swap"
            rel="stylesheet"
        />

    </head>

    <body>

        <a class="skip-link" href="#main-content">Skip to content</a>

        <Navbar />

        <slot />

    </body>

</html>